# Source SQL Server
SOURCE_DB_DRIVER=ODBC Driver 17 for SQL Server
SOURCE_DB_HOST=
SOURCE_DB_PORT=1433
SOURCE_DB_NAME=xomdata_dataset
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=

# Destination PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shopee_analytics
POSTGRES_USER=shopee_user
POSTGRES_PASSWORD=

# Pipeline configuration
PIPELINE_BATCH_SIZE=500
PIPELINE_RETRY_COUNT=3
PIPELINE_RETRY_DELAY_SECONDS=5
INCREMENTAL_OVERLAP_MINUTES=10
SOURCE_FRESHNESS_THRESHOLD_MINUTES=1440
RAW_DATA_PATH=/opt/pipeline/data/raw
REJECTED_DATA_PATH=/opt/pipeline/data/rejected
LOG_LEVEL=INFO
